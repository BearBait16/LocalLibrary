DATABASE_URL=postgresql://locallibrary:locallibrary@localhost:5432/locallibrary
OLLAMA_HOST=http://localhost:11434
GEMMA_MODEL=gemma4:e4b
# Context window for Gemma (Ollama's default 4096 is too small for RAG)
GEMMA_NUM_CTX=8192
EMBED_MODEL=nomic-embed-text
# Optional: enables "Also search the web with Gemini" on the search page
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Contact email sent to OpenAlex (polite pool); OPENALEX_API_KEY if you have one
OPENALEX_EMAIL=
OPENALEX_API_KEY=
DATA_DIR=./data
